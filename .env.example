# Meta Model API. Base URL per LiteLLM's Meta provider docs; confirm with the playground's
# "Get code" button. Free credits: the playground notes content may be used for product
# improvement while on credits. Only use your own recordings or openly licensed lectures.
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1

# Models. Avoid the "-contributor" variants until we know what they do with data.
SPOKENSLATE_BOARD_MODEL=muse-spark-1.3
SPOKENSLATE_RESOLVE_MODEL=muse-spark-1.3
SPOKENSLATE_ESCALATE_MODEL=muse-wonder-1.0
SPOKENSLATE_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
SPOKENSLATE_SAM_MODEL=
SPOKENSLATE_CONFIDENCE_THRESHOLD=0.7

# Camera / page tools (scripts/page_preview.py)
SPOKENSLATE_CAMERA_INDEX=0
SPOKENSLATE_PAPER=letter
SPOKENSLATE_ORIENTATION=landscape
SPOKENSLATE_PAGE_ROTATION=0
