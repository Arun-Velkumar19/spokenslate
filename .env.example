# Meta Model API. Base URL per LiteLLM's Meta provider docs; confirm with the playground's
# "Get code" button. Free credits: the playground notes content may be used for product
# improvement while on credits. Only use your own recordings or openly licensed lectures.
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1

# Seed models. Avoid the "-contributor" variants until we know what they do with data.
SEED_BOARD_MODEL=muse-spark-1.3
SEED_RESOLVE_MODEL=muse-spark-1.3
SEED_ESCALATE_MODEL=muse-wonder-1.0
SEED_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
SEED_SAM_MODEL=
SEED_CONFIDENCE_THRESHOLD=0.7

# Camera / page tools (scripts/page_preview.py)
PAPEROS_CAMERA_INDEX=0
PAPEROS_PAPER=letter
PAPEROS_ORIENTATION=landscape
PAPEROS_PAGE_ROTATION=0
