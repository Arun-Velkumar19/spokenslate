# Meta Model API. Verify base URL and current model IDs in the docs at kickoff.
META_API_KEY=
META_API_BASE_URL=

# Compile model: benchmark Spark vs Wonder on Oct 26-27 (parse quality + latency), then pick one.
PAPEROS_COMPILE_MODEL=muse-spark-1.1
PAPEROS_ALT_MODEL=muse-wonder-1.0

PAPEROS_CAMERA_INDEX=0
PAPEROS_MIC_DEVICE=
PAPEROS_TARGET=bitrun

# Page: letter | a4, landscape | portrait. Rotation 0/90/180/270: use 180 if the camera
# faces you (e.g. webcam on the laptop looking down). scripts/page_preview.py tells you.
PAPEROS_PAPER=letter
PAPEROS_ORIENTATION=landscape
PAPEROS_PAGE_ROTATION=0
